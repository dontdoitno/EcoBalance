<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<style>
  @page { size: A4; margin: 20mm 15mm; }
  body { font-family: "DejaVu Sans", Arial, sans-serif; color: #1f2937; font-size: 11pt; line-height: 1.5; }
  h1 { font-size: 22pt; margin-bottom: 4pt; }
  h2 { font-size: 15pt; margin-top: 18pt; border-bottom: 1.5pt solid #d1d5db; padding-bottom: 4pt; }
  .subtitle { color: #4b5563; font-size: 11pt; margin-top: 0; }
  .banner { background: #fef3c7; border: 1pt solid #f59e0b; padding: 8pt 10pt; border-radius: 4pt; font-size: 9.5pt; margin: 10pt 0; }
  .metric { background: #f9fafb; border-radius: 6pt; padding: 10pt 14pt; margin: 8pt 0; }
  .metric .value { font-size: 26pt; font-weight: bold; }
  .metric .unit { color: #4b5563; font-size: 10pt; }
  table { width: 100%; border-collapse: collapse; margin: 8pt 0; font-size: 9.5pt; }
  th, td { text-align: left; padding: 5pt 8pt; border-bottom: 0.5pt solid #e5e7eb; }
  th { background: #f3f4f6; font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.03em; color: #374151; }
  .rating-critical { color: #b91c1c; font-weight: 600; }
  .rating-significant { color: #92400e; font-weight: 600; }
  .rating-low { color: #15803d; font-weight: 600; }
  .footer { margin-top: 24pt; padding-top: 10pt; border-top: 0.5pt solid #d1d5db; color: #6b7280; font-size: 8.5pt; }
  .kv p { margin: 3pt 0; }
</style>
</head>
<body>
{% block content %}{% endblock %}
<div class="footer">
  <p>Дата формирования: {{ generated_at }}</p>
  <p>Версия справочника коэффициентов: {{ factor_version }}</p>
  <p>Сгенерировано системой EcoBalance (расчётное ядро ecobalance_core)</p>
</div>
</body>
</html>
