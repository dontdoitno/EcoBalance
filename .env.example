# EcoBalance — environment variables template
# Copy to .env and fill in local values. Never commit the real .env.

# --- Database ---
POSTGRES_USER=ecobalance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecobalance
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ecobalance:change-me@db:5432/ecobalance

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me
API_SESSION_COOKIE_NAME=ecobalance_session
API_CORS_ORIGINS=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_PORT=3000

# --- Docs ---
DOCS_PORT=8001
